# ═══════════════════════════════════════════════════════════
#  BARBER VIP — Variables de Entorno
#  1. Copia este archivo como .env
#  2. Cambia los valores (especialmente JWT_SECRET y ADMIN_PASSWORD)
#  3. En Railway/Render agrega estas variables en el dashboard
# ═══════════════════════════════════════════════════════════

# Puerto (Railway lo asigna automáticamente via $PORT)
PORT=4000

# URL del frontend en Netlify (para CORS)
# Ejemplo: https://barbervip.netlify.app
FRONTEND_URL=https://tu-sitio.netlify.app

# ── SEGURIDAD — CAMBIAR OBLIGATORIAMENTE ────────────────────
# Genera una clave random en: https://generate-secret.vercel.app/64
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_ALEATORIA_32_CHARS_MINIMO

JWT_EXPIRES_IN=8h

# ── Credenciales del Administrador ──────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=barbervip2024

# ── Base de datos SQLite ────────────────────────────────────
# En Railway usa /tmp/ ya que el filesystem es efímero
# Para persistencia real en Railway, usar Railway MySQL/PostgreSQL
DB_PATH=./db/barbervip.db

# ── Entorno ──────────────────────────────────────────────────
NODE_ENV=production
