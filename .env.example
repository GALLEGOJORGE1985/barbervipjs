
# ═══════════════════════════════════════════════════════════
#  BARBER VIP — Variables de Entorno (Backend)
#  1. Copia este archivo como .env para desarrollo local
#  2. En Render: agrega estas mismas variables en
#     Dashboard → tu servicio → Environment
#  3. NUNCA subas el archivo .env real a GitHub
# ═══════════════════════════════════════════════════════════

# Puerto (Render lo asigna automáticamente via $PORT)
PORT=4000

# Entorno
NODE_ENV=production

# URL del frontend en Netlify (para CORS), separadas por coma si hay varias
FRONTEND_URL=https://tu-sitio.netlify.app

# ── BASE DE DATOS POSTGRESQL ─────────────────────────────────
# En Render: crea un servicio "PostgreSQL" (plan Free) y copia
# la "Internal Database URL" que te da Render aquí.
# Formato: postgresql://usuario:password@host:5432/nombre_bd
DATABASE_URL=postgresql://usuario:password@host:5432/barbervip

# ── SEGURIDAD — CAMBIAR OBLIGATORIAMENTE ────────────────────
# Genera una clave random en: https://generate-secret.vercel.app/64
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_ALEATORIA_32_CHARS_MINIMO
JWT_EXPIRES_IN=8h

# ── Credenciales del Administrador (valores iniciales) ──────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=barbervip2024
